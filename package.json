{
  "name": "@mayf3/vehicle-pet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "description": "Configurable Pet Engine V1 with declarative bundled Pet Packs and a MockProgressSource prototype shell",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --project unit --project dom",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "oxlint src tests scripts",
    "check:contracts": "vitest run --project contracts",
    "assets:generate": "node scripts/generate-pack-assets.mjs",
    "assets:check": "node scripts/generate-pack-assets.mjs --check",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e && pnpm build && pnpm check:contracts && pnpm assets:check"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "idb": "^8.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^27.0.0",
    "oxlint": "^1.14.0",
    "sharp": "^0.34.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
