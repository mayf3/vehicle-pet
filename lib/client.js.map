        "scale": "individual",
        "camera": "close",
        "milestone": "inline"
      },
      "upgrade": {
        "transition": "crossfade",
        "reveal": "subject-swap",
        "celebration": "glow-pulse"
      },
      "keepsakeId": "ks-sprout"
    },
    {
