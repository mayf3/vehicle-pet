        "en": "Branches unfold into a clear canopy."
      },
      "milestone": {
        "zh-CN": "解锁小树纪念。",
        "en": "Tree keepsake unlocked."
      },
      "sceneId": "s-tree",
      "presentation": {
        "scale": "group",
        "camera": "city",
        "milestone": "inline"
      },
      "upgrade": {
        "transition": "layer-build",
        "reveal": "scene-expand",
        "celebration": "spark-burst"
      },
      "keepsakeId": "ks-tree"
