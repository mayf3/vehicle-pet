      "stageName": {
        "zh-CN": "首航出发",
        "en": "First Dispatch"
      },
      "summary": {
        "zh-CN": "无人驾驶小车首航出发，车内无人，后方跟着 1 辆迷你保护车。",
        "en": "An unmanned car sets out on its first run, a mini escort car following behind."
      },
      "milestone": {
        "zh-CN": "第一次上路，旅程正式开始。",
        "en": "First run on the road; the journey begins."
