{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vehicle-pet/pet-presentation-v1",
  "title": "Pet Presentation V1",
  "description": "Declarative, code-free pet presentation data (V8 CTR-038). Everything a pet is, as data; the wiring generator emits the TypeScript module consumed by the registry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "displayName", "recipe", "packId", "userSelectable", "gradePolicy", "behavior", "license"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "displayName": {
      "type": "object", "additionalProperties": false, "required": ["zh-CN", "en"],
      "properties": { "zh-CN": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
    },
    "recipe": { "enum": ["engine-scene", "pose-sprite"] },
    "packId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "userSelectable": { "type": "boolean" },
    "gradePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["showExactLevelNumber", "showDescription", "insigniaMode"],
      "properties": {
        "showExactLevelNumber": { "type": "boolean" },
        "showDescription": { "type": "boolean" },
        "insigniaMode": { "enum": ["none", "overlay", "wearable"] }
      }
    },
    "behavior": {
      "type": "object", "additionalProperties": false,
      "required": ["ambientPool", "stateReactions", "petting"],
      "properties": {
        "ambientPool": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "stateReactions": {
          "type": "object", "additionalProperties": false,
          "required": ["completed", "failed", "working", "needs-input"],
          "properties": {
            "completed": { "enum": ["bounce", "proud", "nod"] },
            "failed": { "enum": ["shy", "sleepy"] },
            "working": { "enum": ["nod", "wave"] },
            "needs-input": { "enum": ["peek", "wave"] }
          }
        },
        "petting": {
          "type": "object", "additionalProperties": false, "required": ["variant", "decoration"],
          "properties": { "variant": { "$ref": "#/definitions/expressionVariant" }, "decoration": { "enum": ["heart", "sparkles"] } }
        }
      }
    },
    "license": {
      "type": "object", "additionalProperties": false, "required": ["license", "attribution", "provenance"],
      "properties": {
        "license": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "minLength": 1 }
      }
    },
    "poseSprite": {
      "type": "object", "additionalProperties": false, "required": ["variantPose", "poseSource"],
      "properties": {
        "variantPose": {
          "type": "object", "additionalProperties": false,
          "required": ["idle", "idle-happy", "idle-curious", "idle-sleepy", "working", "needs-input", "completed", "completed-proud", "failed", "cancelled"],
          "properties": {
            "idle": { "type": "integer", "minimum": 0 },
            "idle-happy": { "type": "integer", "minimum": 0 },
            "idle-curious": { "type": "integer", "minimum": 0 },
            "idle-sleepy": { "type": "integer", "minimum": 0 },
            "working": { "type": "integer", "minimum": 0 },
            "needs-input": { "type": "integer", "minimum": 0 },
            "completed": { "type": "integer", "minimum": 0 },
            "completed-proud": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "cancelled": { "type": "integer", "minimum": 0 }
          }
        },
        "poseSource": { "$ref": "#/definitions/assetSource" },
        "insignia": {
          "type": "object", "additionalProperties": false, "required": ["assetSource"],
          "properties": { "assetSource": { "$ref": "#/definitions/assetSource" } }
        }
      }
    },
    "engineScene": {
      "type": "object", "additionalProperties": false, "required": ["expressionAnchors"],
      "properties": {
        "expressionAnchors": {
          "type": "object",
          "patternProperties": { "^l\\d+$": { "$ref": "#/definitions/anchorRect" } },
          "additionalProperties": false,
          "minProperties": 1
        }
      }
    }
  },
  "definitions": {
    "expressionVariant": {
      "enum": ["idle", "idle-happy", "idle-curious", "idle-sleepy", "working", "needs-input", "completed", "completed-proud", "failed", "cancelled"]
    },
    "anchorRect": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "type": "number", "minimum": 0, "maximum": 100 }
    },
    "assetSource": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": { "enum": ["files", "module"] },
        "dir": { "type": "string", "pattern": "^(\\./|\\.\\./)[^:*?\"<>|]*$", "description": "files kind: directory of pose-N.png/.webp pairs, relative to the pet directory" },
        "path": { "type": "string", "description": "module kind: import path of a generated asset module, relative to the pet directory" },
        "poses": { "type": "string", "description": "module kind: export name of the pose array" },
        "alphaBounds": { "type": "string", "description": "module kind: export name of the per-pose alpha bounds" },
        "insigniaAssets": { "type": "string", "description": "module kind: export name of the insignia asset array" },
        "insigniaAnchors": { "type": "string", "description": "module kind: export name of the per-pose insignia anchors" }
      }
    }
  }
}
